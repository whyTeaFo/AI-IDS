# =============================================================================
# AI-IDS 项目 .gitignore
# =============================================================================
# 原则：只提交「手写的源码」和「小体积的交付物」。
#       下载来的数据集、跑出来的模型权重，一律不入库 —— 它们都能由
#       scripts/download_data.sh + scripts/run_pipeline.sh 重新生成。
# =============================================================================


# ---- 数据（约 2.1GB，全部可重新生成）----------------------------------------
# 整目录忽略，而不是逐个列 data/raw/、data/raw_synthetic/……
# 这样以后新增 data/xxx_synthetic/ 之类的子目录不会再漏网。
data/

# 抓包文件（如果放在 data/ 之外）
*.pcap
*.pcapng


# ---- 模型权重与合成实验产物（约 230MB，训练可复现）--------------------------
# 注意：results/metrics/ 和 results/figures/ 是交付物（报告的依据），要入库，
#       所以这里只忽略 models/ 和 synthetic/，不能整个 results/ 一起忽略。
results/models/
results/synthetic/

# 兜底：任何位置的模型二进制与序列化对象都不入库
*.joblib
*.pkl
*.pickle
*.h5
*.pt
*.onnx


# ---- 数据库 ----------------------------------------------------------------
# WAL 模式下 SQLite 会额外生成 -wal / -shm 伴随文件，
# 只写 *.db 会漏掉它们（本项目 data/aiids.db-wal 有 2.6MB）。
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3


# ---- 日志 ------------------------------------------------------------------
logs/
*.log


# ---- Python 运行 / 构建产物 ------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---- 测试 / 类型检查 / 代码检查缓存 ----------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/


# ---- 环境变量与密钥 --------------------------------------------------------
.env
.env.*
!.env.example


# ---- 编辑器 / 系统 ---------------------------------------------------------
# 前面加 / 锚定到仓库根目录，避免误伤 src/ 下同名的包
/.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
